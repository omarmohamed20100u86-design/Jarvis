# JARVIS — server-side environment variables
# Add these in Vercel > Project > Settings > Environment Variables.
# Keep all API keys private. Do not prefix them with NEXT_PUBLIC_ or expose them in browser code.

# Claude model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Other AI providers (optional)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Optional Piper speech output service.
# If blank or unreachable, Jarvis uses the browser's built-in speech synthesis.
PIPER_URL=
